#!/bin/sh
# Pre-commit SSR SEO gate. Skips commits that cannot affect rendered HTML.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

if ! printf '%s\n' "$staged" | grep -Eq '^(src/|messages/|public/|scripts/|package\.json|next\.config\.ts|Dockerfile|docker-compose\.yml|deploy/)'; then
  echo "pre-commit: no SEO-relevant changes, skipping SSR SEO audit"
  exit 0
fi

# A production build already covers the staged files when .next/BUILD_ID is
# newer than every one of them. Reuse it so a commit never pays for a second
# build; the audit still runs against the same SSR HTML either way.
if [ -f .next/BUILD_ID ]; then
  build_fresh=1
  for file in $staged; do
    if [ -f "$file" ] && [ "$file" -nt .next/BUILD_ID ]; then
      build_fresh=0
      break
    fi
  done
  if [ "$build_fresh" -eq 1 ]; then
    echo "pre-commit: reusing fresh production build for SSR SEO audit"
    SEO_AUDIT_SKIP_BUILD=1 npm run seo:audit
    exit $?
  fi
fi

echo "pre-commit: running SSR SEO audit (fresh build)…"
npm run seo:audit
